# Licensed music: BlueTreeAudio's terms don't allow redistributing the track, so it isn't committed.
# Put "Corporate Motivational (without piano melody).wav" here to rebuild the soundtrack.
video/audio/music/*.wav
video/audio/music/*.mp3
